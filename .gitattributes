# Every text file is LF in the repository and in the working tree, on every platform.
* text=auto eol=lf

# Golden vectors are bytes, compared exactly.
contracts/**/*.bin binary
native/**/tests/fixtures/**/*.png binary

# Fixture fonts: bytes DirectWrite reads as they are.
native/**/tests/fixtures/**/*.woff2 binary

# Fixture images: the avatar decoder's inputs, some deliberately malformed.
platform/**/tests/fixtures/**/*.png binary
platform/**/tests/fixtures/**/*.jpg binary
platform/**/tests/fixtures/**/*.webp binary

# Product assets: fonts web serves as they are.
web/src/ui/fonts/*.woff2 binary

# The landing's link preview, drawn by web/dev/og-image.ts.
web/src/features/landing/*.png binary
