# Public development values, loaded through moon's envFile by server:dev, web:dev and web:start.
# None is a secret: the server refuses this peer key, the all-zero TOTP key, the all-zero lease
# key and password-only sign-in unless its WebAuthn origin is a localhost one. Paths are relative
# to the project a task runs in.
LUCENT_DATABASE_URL=postgres://postgres@127.0.0.1:4719/lucent
LUCENT_INTERNAL_LISTEN=127.0.0.1:4712
LUCENT_WEB_INTERNAL_KEY=lucent-dev-internal-key-public-not-a-secret-0000
LUCENT_PRODUCTS_DIR=../../products
LUCENT_TOTP_KEYS=dev:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
LUCENT_WEBAUTHN_RP_ID=localhost
LUCENT_WEBAUTHN_ORIGIN=http://localhost:4710
LUCENT_WEB_LISTEN=127.0.0.1:4710
LUCENT_PLATFORM_INTERNAL_URL=http://127.0.0.1:4712
LUCENT_PUBLIC_ORIGIN=http://localhost:4710
# A password signs in alone and staff actions skip the step-up; remove it to test the real flows.
LUCENT_DEV_PASSWORD_ONLY=1
# The loaders' listener, so a dev loader can reach the dev server. The lease key is the all-zero
# seed, refused unless the WebAuthn origin is a localhost one; the artifact directory is where
# `ops publish-loader --artifact-dir` writes.
LUCENT_NATIVE_LISTEN=127.0.0.1:4711
LUCENT_NATIVE_ORIGIN=http://127.0.0.1:4711
LUCENT_LEASE_SIGNING_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
LUCENT_ARTIFACT_DIR=../../.moon/cache/dev/artifacts
