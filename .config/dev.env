# Public development values, loaded through moon's envFile by server:dev, web:dev and web:start.
# None is a secret: the server refuses this peer key and the all-zero TOTP key unless its WebAuthn
# origin is a localhost one. Paths are relative to the project a task runs in.
LUCENT_DATABASE_URL=postgres://postgres@127.0.0.1:4719/lucent
LUCENT_INTERNAL_LISTEN=127.0.0.1:4712
LUCENT_WEB_INTERNAL_KEY=lucent-dev-internal-key-public-not-a-secret-0000
LUCENT_PRODUCTS_DIR=../../products
LUCENT_TOTP_KEYS=dev:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
LUCENT_WEBAUTHN_RP_ID=localhost
LUCENT_WEBAUTHN_ORIGIN=http://localhost:4710
LUCENT_WEB_LISTEN=127.0.0.1:4710
LUCENT_PLATFORM_INTERNAL_URL=http://127.0.0.1:4712
LUCENT_PUBLIC_ORIGIN=http://localhost:4710
