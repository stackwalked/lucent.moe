{
  "extends": "../.config/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowArbitraryExtensions": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["bun", "vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "integration/**/*.ts",
    "dev/**/*.ts",
    "vite.config.ts"
  ]
}
