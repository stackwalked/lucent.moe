(access) {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				# Kept: method, host, remote address, status, size, duration, path.
				# Setup and device tokens ride in paths and queries; Cookie, Authorization,
				# DPoP, Set-Cookie and the Lucent-* headers are never audit data. Header maps
				# are dropped whole: delete has no wildcard, so Lucent-* cannot be named.
				# The same filter is repeated for the default logger in Caddyfile.
				request>headers delete
				resp_headers delete
				user_id delete
				# A field takes one filter, so one regexp does both jobs: drop everything
				# from the first "?", and remove the token segment of /setup/<token> and
				# /auth/device/<id>, keeping the prefix.
				request>uri regexp "^(?:(/setup/|/auth/device/)[^/?]*)?([^?]*)(?:\?.*)?$" "${1}${2}"
			}
		}
	}
}

(direct_client) {
	# reverse_proxy now builds its X-Forwarded-* headers from this connection.
	request_header -Forwarded
	request_header -X-Real-IP
	request_header -X-Forwarded-*
}

lucent.moe {
	import access
	import direct_client
	encode zstd gzip
	reverse_proxy unix//run/lucent/web/http.sock
}

api.lucent.moe {
	import access
	handle /v1/* {
		import direct_client
		reverse_proxy unix//run/lucent/native/http.sock {
			header_up -Cookie
			header_down -Set-Cookie
			header_down -Access-Control-*
		}
	}
	handle {
		respond 404
	}
}

http://api.lucent.moe {
	import access
	respond 404
}

http://127.0.0.1:2020 {
	bind 127.0.0.1
	respond /_health 200
}
