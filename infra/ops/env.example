# Names only. provision.sh creates /etc/lucent/staging.env outside the checkout.
# Fill these six (use a random database password, e.g. 64 random hex digits).
POSTGRES_PASSWORD=
LUCENT_WEB_INTERNAL_KEY=
LUCENT_TOTP_KEYS=
LUCENT_LEASE_SIGNING_KEY=
LUCENT_CODE_PUBLIC_KEY=
LUCENT_FACTS_PUBLIC_KEYS=

# Optional platform mail. Leave all blank to queue without sending; log needs no credentials.
LUCENT_MAIL_PROVIDER=
LUCENT_MAIL_API_KEY=
LUCENT_MAIL_FROM=

# Fixed by compose.yml. The pg client takes PGPASSWORD from POSTGRES_PASSWORD,
# not from a URL, where punctuation in a password could change its meaning.
# Leave blank. No env file is passed wholesale to any container.
LUCENT_DATABASE_URL=
LUCENT_INTERNAL_LISTEN=
LUCENT_NATIVE_LISTEN=
LUCENT_NATIVE_ORIGIN=
LUCENT_PRODUCTS_DIR=
LUCENT_ARTIFACT_DIR=
LUCENT_WEBAUTHN_RP_ID=
LUCENT_WEBAUTHN_ORIGIN=
LUCENT_WEB_LISTEN=
LUCENT_PLATFORM_INTERNAL_URL=
LUCENT_PUBLIC_ORIGIN=

# Not forwarded: use the built-in breach service, never development sign-in.
LUCENT_PWNED_PASSWORDS_URL=
LUCENT_DEV_PASSWORD_ONLY=
