{
  "version": 10,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../.moon/cache/cmake/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/toolchain.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "VCPKG_TARGET_TRIPLET": "x64-windows-lucent",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "fuzz",
      "inherits": "base",
      "$comment": [
        "RelWithDebInfo, not Debug: optimized code runs more inputs a second, ASan does the",
        "checking Debug's STL assertions would, and the release CRT (/MT) matches the release",
        "libraries vcpkg links. Debug info keeps sanitizer stacks symbolized. Run a target with",
        "`.moon/cache/cmake/fuzz/libs/<lib>/<lib>_fuzz_<name>.exe <new corpus dir> <seed dir>",
        "-max_total_time=<seconds>`; each target's file says what to seed it with."
      ],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "LUCENT_FUZZ": true }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "targets": ["all", "all_verify_interface_header_sets"]
    },
    { "name": "release", "configurePreset": "release" },
    { "name": "fuzz", "configurePreset": "fuzz", "targets": ["fuzzers"] }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
