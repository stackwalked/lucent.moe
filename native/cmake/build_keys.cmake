# lucent::build: <lucent/core/build/subkeys.hpp>, this build's per-purpose subkeys as constexpr
# values in lucent::build, generated at configure time into the build tree only. The path sits under
# core, as stdx does, because an include prefix names a moon project and this target is none.
# Linking lucent::build, not core, is what makes the header reachable.
#
# A Release build derives the subkeys from the release's 256-bit master seed, the file
# LUCENT_MASTER_SEED names (32 raw bytes, never in git); every other build derives them from the
# dev seed, 32 zero bytes, so dev values are fixed and public. The seed itself is read here and goes
# nowhere else: not the cache, not a command line, not the log, not the header.

set(LUCENT_MASTER_SEED "" CACHE FILEPATH "The release's 256-bit master seed: 32 raw bytes")

# One subkey per purpose; a purpose's label is part of every derivation, so the names here never
# change once a release ships.
set(lucent_build_purposes fact event api link_order)

# Derivation: subkey = SHA3-256(hex(seed) || "lucent::build::" || purpose), at configure time.
# SHA-3 is a sponge, so unlike SHA-2 a secret prefix is a sound keyed function (no length
# extension; it is how KMAC is built). The key comes first and has a fixed length, so the encoding
# is unambiguous. Preimage resistance makes it one-way: a shipped subkey gives back neither the seed
# nor a sibling. CMake's own hash avoids building a host tool before the header exists, and keeps
# the seed off every command line; BLAKE2b through lucent::crypto would add that tool and no
# security a 256-bit uniform seed needs.
function(lucent_derive_subkeys seed_hex label out_header)
    set(declarations "")
    foreach(purpose IN LISTS lucent_build_purposes)
        string(SHA3_256 digest "${seed_hex}lucent::build::${purpose}")
        string(APPEND declarations "inline constexpr subkey ${purpose}_subkey{\n")
        # Eight bytes a line, as devkey's key header. CMake's regex has no {n} repetition, so the
        # 64 hex digits are cut into lines by position.
        foreach(start RANGE 0 48 16)
            string(SUBSTRING "${digest}" ${start} 16 line)
            string(REGEX REPLACE "([0-9a-f][0-9a-f])" "std::byte{0x\\1}, " line "${line}")
            string(STRIP "${line}" line)
            string(APPEND declarations "    ${line}\n")
        endforeach()
        string(APPEND declarations "};\n\n")
    endforeach()
    string(
        CONCAT text
        "// Generated by lucent::build from ${label}; do not edit.\n"
        "#pragma once\n\n#include <array>\n#include <cstddef>\n\n"
        "namespace lucent::build {\n\n"
        "using subkey = std::array<std::byte, 32>;\n\n"
        "${declarations}"
        "}\n"
    )
    # file(CONFIGURE) rewrites only on a change, so a reconfigure rebuilds nothing.
    file(CONFIGURE OUTPUT "${out_header}" CONTENT "${text}" @ONLY)
endfunction()

function(lucent_build_seed_hex out_hex out_label)
    if(NOT CMAKE_BUILD_TYPE STREQUAL "Release")
        string(REPEAT "00" 32 dev_seed)
        set(${out_hex} "${dev_seed}" PARENT_SCOPE)
        set(${out_label} "the dev seed (32 zero bytes)" PARENT_SCOPE)
        return()
    endif()
    if(NOT LUCENT_MASTER_SEED OR NOT EXISTS "${LUCENT_MASTER_SEED}")
        message(
            FATAL_ERROR
            "a Release build needs LUCENT_MASTER_SEED: the path of a file holding the release's "
            "256-bit master seed (pass -DLUCENT_MASTER_SEED=<file>)"
        )
    endif()
    file(SIZE "${LUCENT_MASTER_SEED}" seed_size)
    if(NOT seed_size EQUAL 32)
        message(
            FATAL_ERROR
            "LUCENT_MASTER_SEED names a file of ${seed_size} bytes; a master seed is 32 raw bytes"
        )
    endif()
    # A new seed in the same file reconfigures, so the header never outlives its seed.
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${LUCENT_MASTER_SEED}")
    file(READ "${LUCENT_MASTER_SEED}" seed_hex HEX)
    set(${out_hex} "${seed_hex}" PARENT_SCOPE)
    set(${out_label} "the master seed (LUCENT_MASTER_SEED)" PARENT_SCOPE)
endfunction()

# A function, so the seed lives only in its scope and no later list file can read it.
function(lucent_generate_build_header)
    set(generated "${CMAKE_BINARY_DIR}/generated/build")
    set(header "${generated}/lucent/core/build/subkeys.hpp")
    lucent_build_seed_hex(seed_hex label)
    lucent_derive_subkeys("${seed_hex}" "${label}" "${header}")
    add_library(lucent_build INTERFACE)
    add_library(lucent::build ALIAS lucent_build)
    target_sources(
        lucent_build
        INTERFACE FILE_SET HEADERS BASE_DIRS "${generated}" FILES "${header}"
    )
    set_target_properties(lucent_build PROPERTIES VERIFY_INTERFACE_HEADER_SETS ON)
endfunction()

lucent_generate_build_header()
