# Writes fxc's bytecode as a header of one constexpr array, for lucent_shaders (lucent.cmake).
# Run as a script: -DBYTECODE=<.cso> -DHEADER=<.hpp> -DNAMESPACE=<ns> -DVARIABLE=<name>
# -DSOURCE=<the .hlsl it came from>.

file(READ "${BYTECODE}" hex HEX)
string(LENGTH "${hex}" digits)
math(EXPR size "${digits} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "std::byte{0x\\1}," bytes "${hex}")
# Twelve bytes a line keeps the header readable in a diff and under any line limit.
string(REGEX REPLACE "((std::byte\\{0x..\\},){12})" "\\1\n    " bytes "${bytes}")
file(
    WRITE "${HEADER}"
    "// Generated by lucent_shaders from ${SOURCE}; do not edit.\n"
    "#pragma once\n\n#include <array>\n#include <cstddef>\n\n"
    "namespace ${NAMESPACE} {\n\n"
    "inline constexpr std::array<std::byte, ${size}> ${VARIABLE}{\n    ${bytes}\n};\n\n}\n"
)
