{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"$CLAUDE_PROJECT_DIR\" \"$CLAUDE_PROJECT_DIR/tools/lint/format_file.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
